local PICKAXE_SLOT = 3

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local GuiService = game:GetService("GuiService")
local CoreGui = game:GetService("CoreGui")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local Packets
repeat
    local s, r = pcall(function() return require(ReplicatedStorage.Modules.Packets) end)
    if s and r then Packets = r end
    task.wait(0.1)
until Packets

local events = ReplicatedStorage:WaitForChild("Events")
local spawnFirst = events:WaitForChild("SpawnFirst")

local playerGui = player:WaitForChild("PlayerGui")
local spawnGui = playerGui:WaitForChild("SpawnGui")
local mainGui = playerGui:WaitForChild("MainGui")
local topbar = playerGui:WaitForChild("Topbar")

local POSITION_THRESHOLD = 15
local RETRY_INTERVAL = 15
local SWING_COOLDOWN = 0.05
local SWING_RADIUS = 17
local PICKUP_RADIUS = 20
local PICKUP_RADIUS_SQ = PICKUP_RADIUS * PICKUP_RADIUS
local EQUIP_COOLDOWN = 0.6

local scriptRunning = true
local lastSwingTime = 0
local lastEquipTime = 0

local function attemptReconnect()
    task.wait(3)
    local success, err = pcall(function()
        TeleportService:Teleport(game.PlaceId, player)
    end)
    if not success then
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
        end)
    end
end

GuiService.ErrorMessageChanged:Connect(attemptReconnect)
task.spawn(function()
    local robloxPromptGui = CoreGui:WaitForChild("RobloxPromptGui", 15)
    if robloxPromptGui then
        local promptHolder = robloxPromptGui:WaitForChild("promptOverlay", 10)
        if promptHolder then
            promptHolder.ChildAdded:Connect(function(child)
                if child.Name == "ErrorPrompt" then
                    attemptReconnect()
                end
            end)
        end
    end
end)

local function getCharacterPosition()
    local character = player.Character
    if not character then return nil end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position end
    return nil
end

local function hasPositionChangedEnough(pos1, pos2)
    if not pos1 or not pos2 then return false end
    return (pos2 - pos1).Magnitude >= POSITION_THRESHOLD
end

local function spawnOnBed()
    while scriptRunning do
        task.wait(100)
        
        local posBefore = nil
        while not posBefore and scriptRunning do
            posBefore = getCharacterPosition()
            if not posBefore then
                task.wait(0.5)
            end
        end
        if not scriptRunning then return false end
        task.wait(3)

        pcall(function() spawnFirst:InvokeServer(true) end)
        task.wait(5)

        local posAfter = getCharacterPosition()
        if hasPositionChangedEnough(posBefore, posAfter) then
            player:SetAttribute("hasSpawned", true)
            return true
        end

        task.wait(RETRY_INTERVAL)
    end
    return false
end

local function initializeGUI(character)
    camera.CameraType = Enum.CameraType.Custom
    task.wait(0.5)

    if character and character:FindFirstChild("Humanoid") then
        camera.CameraSubject = character.Humanoid
    end

    spawnGui.Enabled = false
    mainGui.Enabled = true
    topbar.Enabled = true
end

local function findCrystalGuardian()
    local resources = Workspace:FindFirstChild("Resources")
    if not resources then return nil end
    for _, obj in ipairs(resources:GetChildren()) do
        if obj:IsA("Model") and obj.Name == "Crystal Guardian" then
            return obj
        end
    end
    return nil
end

local function swingAtCrystalGuardian()
    local character = player.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}

    local targets, seen = {}, {}
    for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, SWING_RADIUS, params)) do
        local model = part:FindFirstAncestorWhichIsA("Model")
        if not model then continue end

        local name = model.Name
        local id = model:GetAttribute("EntityID")
        if not id or seen[id] then continue end

        if name == "Crystal Guardian" then
            seen[id] = true
            table.insert(targets, {entityID = id})
        end
    end

    if #targets > 0 then
        Packets.SwingTool.send({entityIDs = targets, cframe = root.CFrame, timestamp = workspace.DistributedGameTime})
    end
end

local function pickupAllItemsInRadius()
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local pos = hrp.Position

    local itemsFolder = Workspace:FindFirstChild("Items")
    if itemsFolder then
        for _, item in ipairs(itemsFolder:GetChildren()) do
            if item:IsA("BasePart") then
                local eid = item:GetAttribute("EntityID")
                if eid then
                    local diff = item.Position - pos
                    if diff:Dot(diff) <= PICKUP_RADIUS_SQ then
                        pcall(function() Packets.Pickup.send(eid) end)
                        task.wait(0.1)
                    end
                end
            end
        end
    end
end

local function getEquippedTool()
    local wp = workspace:FindFirstChild("Players")
    if not wp then return nil end
    local pFolder = wp:FindFirstChild(player.Name)
    if not pFolder then return nil end
    local toolsFolder = pFolder:FindFirstChild("Tools")
    if not toolsFolder then return nil end
    for _, tool in ipairs(toolsFolder:GetChildren()) do return tool end
    return nil
end

task.spawn(function()
    while scriptRunning do
        task.wait(0.5)
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root and root.Parent then
            local now = os.clock()
            if now - lastEquipTime >= EQUIP_COOLDOWN then
                local equipped = getEquippedTool()
                if not equipped then
                    lastEquipTime = now
                    Packets.EquipTool.send(PICKAXE_SLOT)
                end
            end
        end
    end
end)

local function main()
    local character = player.Character
    if not character then
        character = player.CharacterAdded:Wait()
    end

    local spawned = spawnOnBed()
    if not spawned then return end

    character = player.Character
    if not character then return end
    initializeGUI(character)

    local guardian = findCrystalGuardian()
    if not guardian then return end

    while scriptRunning do
        if not guardian or not guardian.Parent then
            break
        end

        local guardianPart = guardian.PrimaryPart or guardian:FindFirstChildWhichIsA("BasePart")
        if not guardianPart or not guardianPart.Parent then
            break
        end

        local character = player.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if humanoid then
			humanoid.WalkSpeed = 17.5
                humanoid:MoveTo(guardianPart.Position)
            end
        end

        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local dist = (hrp.Position - guardianPart.Position).Magnitude
            if dist <= SWING_RADIUS then
                if tick() - lastSwingTime >= SWING_COOLDOWN then
                    swingAtCrystalGuardian()
                    lastSwingTime = tick()
                end
            end
        end

        task.wait(0.05)
    end

    task.wait(0.1)
    pickupAllItemsInRadius()
    scriptRunning = false
    attemptReconnect()
end

task.spawn(main)
