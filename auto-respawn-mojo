task.wait(100)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualInputManager = game:GetService("VirtualInputManager")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Packets = require(Modules:WaitForChild("util"):WaitForChild("Packets"))

local playerGui = player:WaitForChild("PlayerGui")
local mainGui = playerGui:WaitForChild("MainGui")

local hasDied = false
local isFirstSpawn = true

local function SetupHealthBarTracking(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    local healthPanel = mainGui:FindFirstChild("Panels")
    if healthPanel then
        local healthBar = healthPanel:FindFirstChild("Stats") and 
                           healthPanel.Stats:FindFirstChild("Bars") and 
                           healthPanel.Stats.Bars:FindFirstChild("Health")
        
        if healthBar then
            local healthSlider = healthBar:FindFirstChild("Slider") and 
                                  healthBar.Slider:FindFirstChild("UIGradient")
            local healthLabel = healthBar:FindFirstChild("ValueLabel")
            
            if healthSlider and healthLabel then
                local ratio = humanoid.Health / humanoid.MaxHealth
                healthSlider.Offset = Vector2.new(1 - ratio, 0)
                healthLabel.Text = string.format("%0.1f", humanoid.Health)
                
                humanoid.HealthChanged:Connect(function(newHealth)
                    local newRatio = newHealth / humanoid.MaxHealth
                    healthSlider.Offset = Vector2.new(1 - newRatio, 0)
                    healthLabel.Text = string.format("%0.1f", newHealth)
                end)
            end
        end
    end
end

local function simulateRealBedButtonClick()
    pcall(function()
        local spawnGui = playerGui:FindFirstChild("SpawnGui")
        if not spawnGui then return end
        
        local customization = spawnGui:FindFirstChild("Customization")
        local bedBtn = customization and customization:FindFirstChild("BedButton")
        
        if bedBtn and bedBtn.AbsoluteSize.X > 0 then
            local absPos = bedBtn.AbsolutePosition
            local absSize = bedBtn.AbsoluteSize
            local guiInset = GuiService:GetGuiInset()
            
            local targetX = absPos.X + (absSize.X / 2)
            local targetY = absPos.Y + (absSize.Y / 2) + guiInset.Y
            
            VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
        end
    end)
end

local function InitializeStartup(character)
    task.wait(0.5)
    simulateRealBedButtonClick()

    task.wait(1)
    SetupHealthBarTracking(character)
end

local function RunPostDeathSequence()
    task.wait(15)

    local character = player.Character
    if not character then return end

    simulateRealBedButtonClick()
    task.wait(1)

    SetupHealthBarTracking(character)
end

local function OnCharacterAdded(character)
    local humanoid = character:WaitForChild("Humanoid")

    humanoid.Died:Connect(function()
        hasDied = true
    end)

    if isFirstSpawn then
        isFirstSpawn = false
        task.spawn(InitializeStartup, character)
    elseif hasDied then
        hasDied = false
        task.spawn(RunPostDeathSequence)
    end
end

player.CharacterAdded:Connect(OnCharacterAdded)

if player.Character then
    OnCharacterAdded(player.Character)
end
