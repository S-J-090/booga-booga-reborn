local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local targetPosition = Vector3.new(-1686.31, -3.00, -2534.19)
local maxDistance = 10

local function clickBedButton()
	local playerGui = player:FindFirstChild("PlayerGui")
	local spawnGui = playerGui and playerGui:FindFirstChild("SpawnGui")
	local customization = spawnGui and spawnGui:FindFirstChild("Customization")
	local bedBtn = customization and customization:FindFirstChild("BedButton")
	
	if bedBtn and bedBtn.AbsoluteSize.X > 0 then
		local absPos = bedBtn.AbsolutePosition
		local absSize = bedBtn.AbsoluteSize
		local guiInset = GuiService:GetGuiInset()
		
		local targetX = absPos.X + (absSize.X / 2)
		local targetY = absPos.Y + (absSize.Y / 2) + guiInset.Y
		
		VirtualInputManager:SendMouseMoveEvent(targetX, targetY, game)
		task.wait(0.1)
		
		VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, true, game, 1)
		task.wait(0.15)
		
		VirtualInputManager:SendMouseButtonEvent(targetX, targetY, 0, false, game, 1)
	end
end

task.spawn(function()
	while true do
		task.wait(40)
		
		local character = player.Character
		if character and character:FindFirstChild("HumanoidRootPart") then
			local currentPos = character.HumanoidRootPart.Position
			local distance = (currentPos - targetPosition).Magnitude
			
			if distance <= maxDistance then
				clickBedButton()
			end
		end
	end
end)
